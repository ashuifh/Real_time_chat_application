NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Optional when using the local serviceAccountKey.json file.
# For hosted environments, provide the one-line service-account JSON as a secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=combined
